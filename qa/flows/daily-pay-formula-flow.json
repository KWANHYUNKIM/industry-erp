  "finally": [
    "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const ok=[];const del=async(u)=>{const r=await fetch(u,{method:'DELETE',headers:h});ok.push(r.ok)};const lg=await (await fetch('/api/hr/daily-pay-ledgers',{headers:h})).json();for(const l of (Array.isArray(lg)?lg:[]).filter(l=>l.payMonth==='2092-10'||l.payMonth==='2092-12'))await del('/api/hr/daily-pay-ledgers/'+l.id);const ls=await (await fetch('/api/hr/daily-work-entries?from=2000-01-01&to=2099-12-31',{headers:h})).json();const seen=new Set();for(const l of (Array.isArray(ls)?ls:[]).filter(l=>l.workerName==='QA관리-식')){const k=l.slipDate+'/'+l.slipNo;if(seen.has(k))continue;seen.add(k);await del('/api/hr/daily-work-entries/'+k)}const ws=await (await fetch('/api/hr/daily-workers',{headers:h})).json();for(const w of (Array.isArray(ws)?ws:[]).filter(w=>w.name==='QA관리-식'))await del('/api/hr/daily-workers/'+w.id);const its=await (await fetch('/api/hr/daily-pay-items?kind=ALLOWANCE&includeInactive=true',{headers:h})).json();for(const i of (Array.isArray(its)?its:[]).filter(i=>i.name==='QA관리-수당'))await del('/api/hr/daily-pay-items/'+i.id);sessionStorage.setItem('qaFrClean',String(ok.every(Boolean)));return true})()"
