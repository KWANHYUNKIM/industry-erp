        "js:(()=>{const l=[...[...document.querySelectorAll('[role=dialog]')].find(d=>d.getAttribute('aria-label')==='정렬기준').querySelectorAll('label')].find(x=>x.innerText.trim()==='내림차순');l.querySelector('input').click();return true})()",
        "js:(()=>{[...[...document.querySelectorAll('[role=dialog]')].find(d=>d.getAttribute('aria-label')==='정렬기준').querySelectorAll('button')].find(b=>b.innerText.trim()==='적용').click();return true})()",
