        "expect:[...document.querySelectorAll('[role=dialog]')].find(d=>d.getAttribute('aria-label')==='정렬기준').querySelector('select[aria-label=\"정렬기준1\"]').value==='사원'&&[...document.querySelectorAll('[role=dialog]')].find(d=>d.getAttribute('aria-label')==='정렬기준').querySelector('select[aria-label=\"정렬기준2\"]').value==='수당항목'",
        "js:(()=>{const s=[...document.querySelectorAll('[role=dialog]')].find(d=>d.getAttribute('aria-label')==='정렬기준').querySelector('select[aria-label=\"정렬기준1\"]');const set=Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set;set.call(s,'근무일자');s.dispatchEvent(new Event('change',{bubbles:true}));return true})()",
        "js:(()=>{[...[...document.querySelectorAll('[role=dialog]')].find(d=>d.getAttribute('aria-label')==='정렬기준').querySelectorAll('button')].find(b=>b.innerText.trim()==='적용').click();return true})()",
