    {
      "name": "근무입력 찾기(F3) — 다음 줄로 · 없으면 안내",
      "path": "/hr/work-input",
      "steps": [
        "wait:1500",
        "set:table input[type=date]#0|2091-03-05",
        "set:table input[type=date]#1|2091-03-01",
        "click:찾기(F3)",
        "wait:200",
        "js:(()=>{const i=document.querySelector('input[aria-label=\"격자 찾기\"]');const set=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;set.call(i,'2091-03-01');i.dispatchEvent(new Event('input',{bubbles:true}));i.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}));return true})()",
        "wait:200",
        "expect:(()=>{const rows=[...document.querySelectorAll('table tbody tr')];return rows[1].contains(document.activeElement)})()",
        "js:(()=>{const i=document.querySelector('input[aria-label=\"격자 찾기\"]');const set=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;set.call(i,'QA없는글자');i.dispatchEvent(new Event('input',{bubbles:true}));i.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}));return true})()",
        "wait:200",
        "expect:document.body.innerText.includes('찾는 내용이 없습니다.')"
