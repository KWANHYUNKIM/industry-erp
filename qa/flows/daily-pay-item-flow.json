        "js:(()=>{const tr=((n)=>[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes(n)))('2092/11 1차수');[...tr.querySelectorAll('a')].find(a=>a.textContent==='삭제').click();return true})()",
