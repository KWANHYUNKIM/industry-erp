        "expect:![...document.querySelectorAll('table tbody tr')].some(t=>t.innerText.includes('2092/11 1차수'))",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const ok=[];const ls=await (await fetch('/api/hr/daily-work-entries?from=2000-01-01&to=2099-12-31',{headers:h})).json();for(const l of (Array.isArray(ls)?ls:[]).filter(l=>l.workerName==='QA관리-야근'))ok.push((await fetch('/api/hr/daily-work-entries/'+l.slipDate+'/'+l.slipNo,{method:'DELETE',headers:h})).ok);const ws=await (await fetch('/api/hr/daily-workers',{headers:h})).json();for(const w of ws.filter(w=>w.name==='QA관리-야근'))ok.push((await fetch('/api/hr/daily-workers/'+w.id,{method:'DELETE',headers:h})).ok);sessionStorage.setItem('qaPiClean',String(ok.length>=2&&ok.every(Boolean)));return true})()",
