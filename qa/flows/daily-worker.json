        "clicklast:저장(F8)",
        "wait:1200",
        "js:(async()=>{for(let i=0;i<40;i++){const tr=[...document.querySelectorAll('table tbody tr')].find(t=>t.cells[2]?.innerText.trim()==='QA관리-일용');if(tr){sessionStorage.setItem('qaDwCode',tr.cells[1].innerText.trim());tr.querySelectorAll('a')[1].click();return true}await new Promise(z=>setTimeout(z,250))}return 'not found'})()",
        "clicklast:급여지급사항",
        "expect:document.querySelector('[role=dialog] table tbody tr:first-child td:last-child input').value==='150,000'",
