        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};const ws=await (await fetch('/api/hr/daily-workers',{headers:h})).json();const w=ws.find(x=>x.name==='QA관리-일용');sessionStorage.setItem('qaDwBank',String(!!w&&w.bankName==='신한은행'&&w.phone==='02-111-2222'&&w.passportNo==='M1234567'&&w.text1==='QA추가'));return true})()",
        "expect:sessionStorage.getItem('qaDwBank')==='true'",
        "js:(async()=>{for(let i=0;i<20;i++){const tr=[...document.querySelectorAll('table tbody tr')].find(t=>t.cells[2]?.innerText.trim()==='QA관리-일용');if(tr){tr.querySelector('input[type=checkbox]').click();return true}await new Promise(z=>setTimeout(z,250))}return 'not found'})()",
        "click:선택삭제",
        "wait:1200",
        "expect:![...document.querySelectorAll('table tbody tr')].some(t=>t.cells[2]?.innerText.trim()==='QA관리-일용')"
