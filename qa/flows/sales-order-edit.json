{
  "about": "주문서조회 — 원본 E040204 실측(2026-10-13): [신규(F2)] 저장 → 목록 '진행중' · 품목명(요약) '품목 [규격]', [일자-No.] 를 누르면 '주문수정' 창(일자 잠김) → 수량 고쳐 저장하면 금액이 바뀐다 → 창의 [삭제] '전표를 삭제하겠습니까? - 주문서' → 목록에서 사라진다. node qa/shot.mjs qa/flows/sales-order-edit.json — 만든 주문은 끝에 지운다.",
  "shots": [
    {
      "name": "신규 저장 — 원본처럼 바로 진행중",
      "path": "/sales/orders",
      "steps": [
        "click:신규(F2)",
        "click:매출처 선택",
        "pickrow:QA-CUST",
        "js:document.querySelector('[role=dialog] input[placeholder=\"품목 선택\"]').click(); true",
        "pickrow:QA-PROD",
        "set:[role=dialog] tbody input.text-right#0|4",
        "set:[role=dialog] tbody input.text-right#1|1000",
        "click:출하창고 선택",
        "pickrow:QA-WH",
        "click:저장(F8)",
        "expect:/SN-[0-9]{8}-[0-9]{4} 수주 등록 완료/.test(document.body.innerText)",
        "js:const no = document.body.innerText.match(/SN-([0-9]{4})([0-9]{2})([0-9]{2})-([0-9]{4})(?= 수주 등록 완료)/); sessionStorage.setItem('soEditOrder', no[0]); sessionStorage.setItem('soEditDateNo', `${no[1]}/${no[2]}/${no[3]} -${Number(no[4])}`); true",
        "click:닫기",
        "wait:800",
        "expect:[...document.querySelectorAll('tbody tr')].some((r) => r.innerText.includes(sessionStorage.getItem('soEditDateNo')) && r.innerText.includes('4,400') && r.innerText.includes('진행중'))"
      ]
    },
    {
      "name": "[일자-No.] → 주문수정 — 일자 잠김, 수량 6 으로 저장하면 6,600",
      "path": "/sales/orders",
      "steps": [
        "wait:800",
        "js:[...document.querySelectorAll('tbody a')].find((a) => a.textContent.trim() === sessionStorage.getItem('soEditDateNo')).click(); true",
        "wait:600",
        "expect:document.querySelector('[role=dialog]').innerText.includes('주문수정') && document.querySelector('[role=dialog] input[type=date]').disabled",
        "set:[role=dialog] tbody input.text-right#0|6",
        "click:저장(F8)",
        "wait:1000",
        "expect:!document.querySelector('[role=dialog]') && [...document.querySelectorAll('tbody tr')].some((r) => r.innerText.includes(sessionStorage.getItem('soEditDateNo')) && r.innerText.includes('6,600'))"
      ]
    },
    {
      "name": "주문수정 창의 [삭제] — 원본 문구, 목록에서 사라진다",
      "path": "/sales/orders",
      "steps": [
        "wait:800",
        "js:window.__asked = ''; window.confirm = (m) => { window.__asked = m; return true }; true",
        "js:[...document.querySelectorAll('tbody a')].find((a) => a.textContent.trim() === sessionStorage.getItem('soEditDateNo')).click(); true",
        "wait:600",
        "click:삭제",
        "wait:1000",
        "expect:window.__asked === '전표를 삭제하겠습니까?\\n- 주문서'",
        "expect:![...document.querySelectorAll('tbody a')].some((a) => a.textContent.trim() === sessionStorage.getItem('soEditDateNo'))"
      ]
    }
  ]
}
