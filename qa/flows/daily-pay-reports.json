        "expect:document.querySelector('table').innerText.includes('111-222')",
        "js:(()=>{[...document.querySelectorAll('label')].find(l=>l.textContent.trim()==='사용').querySelector('input').click();return true})()",
        "wait:300",
        "set:input[aria-label=\"지급연월 시작\"]|2099-01",
        "wait:300",
        "expect:!document.querySelector('table').innerText.includes('111-222')",
        "expect:document.querySelector('.ec-report-head').textContent.includes('회사명 :')&&[...document.querySelectorAll('table thead th')][0].innerText.trim()==='급여통장 은행코드'",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};const q=JSON.parse(sessionStorage.getItem('qaDr'));const a=await fetch('/api/hr/daily-pay-ledgers/'+q.l,{method:'DELETE',headers:h});const b=await fetch('/api/hr/daily-workers/'+q.w,{method:'DELETE',headers:h});sessionStorage.setItem('qaDrClean',String(a.ok&&b.ok));return true})()",
        "expect:sessionStorage.getItem('qaDrClean')==='true'"
