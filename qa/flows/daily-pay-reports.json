      "name": "준비 → 사원별급여조회",
      "path": "/hr/daily-payroll/by-worker",
      "steps": [
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const w=await (await fetch('/api/hr/daily-workers',{method:'POST',headers:h,body:JSON.stringify({name:'QA관리-일용R',foreigner:false,employmentInsurance:true,pensionAuto:false,healthAuto:false,dailyWage:200000,fixedIncomeTax:4050,fixedLocalTax:400,bankName:'QA은행',accountNo:'111-222',accountHolder:'QA관리-일용R'})})).json();const l=await (await fetch('/api/hr/daily-pay-ledgers',{method:'POST',headers:h,body:JSON.stringify({payMonth:'2091-12'})})).json();await fetch('/api/hr/daily-pay-ledgers/'+l.id+'/work-confirms',{method:'PUT',headers:h,body:JSON.stringify([{workerId:w.id,days:3}])});await fetch('/api/hr/daily-pay-ledgers/'+l.id+'/calculate',{method:'POST',headers:h});sessionStorage.setItem('qaDr',JSON.stringify({w:w.id,l:l.id}));return true})()",
        "set:input[type=month]#0|2091-12",
