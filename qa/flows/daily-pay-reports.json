        "expect:document.querySelector('table').innerText.includes('QA관리-일용R')",
        "js:(()=>{[...document.querySelectorAll('label')].filter(l=>l.textContent.trim()==='사용')[1].querySelector('input').click();return true})()",
        "wait:300",
        "set:input[aria-label=\"지급일 시작\"]|2000-01-01",
