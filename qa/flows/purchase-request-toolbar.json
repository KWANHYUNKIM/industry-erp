      "steps": [
        "wait:2500",
        "expect:(()=>{const t=[...document.querySelectorAll('.ec-toolbar button:not(.ec-btn-arrow)')].map((b)=>b.textContent.trim());return t.join('|')==='찾기(F3)|정렬|My품목|소요|주문|재고불러오기|품목별안전재고|바코드|전표 바코드|검증|전표불러오기'})()",
        "click:재고불러오기",
        "wait:1500",
        "expect:[...document.querySelectorAll('th')].some((t)=>t.textContent.trim()==='전체수량') && [...document.querySelectorAll('th')].some((t)=>t.textContent.trim()==='창고수량')",
        "click:바코드",
        "wait:300",
        "js:(async()=>{const it=(await (await fetch('/api/items',{headers:{Authorization:'Bearer '+localStorage.getItem('erp_token')}})).json()).find((x)=>x.active!==false);sessionStorage.setItem('prtCode',it.code);return it.code})()",
        "js:(()=>{const i=document.querySelector('input[placeholder=\"바코드/품목코드 후 Enter\"]');const set=(v)=>{Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,v);i.dispatchEvent(new Event('input',{bubbles:true}))};set(sessionStorage.getItem('prtCode'));i.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}));return true})()",
        "wait:500",
