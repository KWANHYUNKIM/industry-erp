        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};const a=(await (await fetch('/api/fixed-assets',{headers:h})).json()).filter(x=>x.name==='QA회계1-비품');for(const x of a){if(x.status==='DISPOSED')await fetch('/api/fixed-assets/'+x.id+'/dispose',{method:'DELETE',headers:h});if(x.accumulatedDepreciation>0)await fetch('/api/fixed-assets/depreciations?period=2026-10&assetId='+x.id,{method:'DELETE',headers:h});await fetch('/api/fixed-assets/'+x.id,{method:'DELETE',headers:h})}return a.length})()",
