{
  "about": "작업지시서조회 · 생산입고조회 — 원본(2026-10-31 loginad)처럼 [신규(F2)] · [생산입고I] · 일자-No. 가 화면을 옮기지 않고 목록 위에 입력 창을 띄운다. node qa/shot.mjs qa/flows/production-windows.json — 만든 전표는 끝에 지운다.",
  "shots": [
    {
      "name": "작업지시서조회 — 알약은 한 줄(전체 · 결재중 · 미확인 · 확인 ▸ 진행중 ▸ 완료), 표 첫 열은 체크박스뿐이고 창고 · 잔여 · 단위가 없다",
      "path": "/production/work-orders",
      "steps": [
        "wait:800",
        "expect:document.querySelectorAll('.ec-pills').length >= 1 && [...document.querySelector('.ec-pills').querySelectorAll('.ec-pill')].map((b)=>b.textContent.trim()).join(',')==='전체,결재중,미확인,확인,진행중,완료'",
        "expect:![...document.querySelectorAll('thead th')].some((th)=>['창고','잔여'].includes(th.innerText.trim()))",
        "expect:!!document.querySelector('thead th input[type=checkbox]')"
      ]
    },
    {
      "name": "작업지시서조회 조건 판 — 거래처그룹1 · 품목구분 · 품목그룹1 은 접힌 줄(▾)을 펼쳐야 나온다",
      "path": "/production/work-orders",
      "steps": [
        "wait:600",
        "click:Search(F3)",
        "expect:!/거래처그룹1/.test(document.querySelector('.ec-cond').innerText)",
        "click:조건 더 보기",
        "expect:/거래처그룹1/.test(document.querySelector('.ec-cond').innerText) && /품목그룹1/.test(document.querySelector('.ec-cond').innerText)"
      ]
    },
    {
      "name": "작업지시서조회 [신규(F2)] — 주소는 그대로이고 목록 위에 '작업지시서입력' 창이 뜬다(제목줄 새창 · 고정 · 새로고침), 아래 줄 저장(F8)▲ · 저장/전표(F7) · 다시 작성 · 닫기 · 웹자료올리기, [닫기] 로 닫힌다",
      "path": "/production/work-orders",
      "steps": [
        "wait:600",
        "click:신규(F2)",
        "wait:800",
        "expect:location.pathname==='/production/work-orders' && document.querySelector('[role=dialog][aria-label=\"작업지시서입력\"]') !== null",
        "expect:['새창','고정','새로고침'].every((t)=>document.querySelector('[role=dialog] .ec-modal-bar button[title=\"'+t+'\"]'))",
        "expect:['저장(F8)','저장/전표(F7)','다시 작성','닫기','웹자료올리기'].every((t)=>[...document.querySelectorAll('[role=dialog] .ec-slip-footer button')].some((b)=>b.textContent.trim()===t))",
        "expect:['정렬','바코드','전표 바코드','검증'].every((t)=>[...document.querySelectorAll('[role=dialog] .ec-toolbar button')].some((b)=>b.textContent.trim()===t))",
        "js:[...document.querySelectorAll('[role=dialog] .ec-slip-footer button')].find((b)=>b.textContent.trim()==='닫기').click(); true",
        "wait:400",
        "expect:!document.querySelector('[role=dialog][aria-label=\"작업지시서입력\"]')"
      ]
    },
    {
      "name": "작업지시서조회 창에서 저장 — 품목 · 수량 · 생산공장을 넣고 [저장(F8)] 하면 창이 말 없이 닫히고 목록에 그 지시가 보인다. 일자-No. 를 누르면 '작업지시서입력(수정)' 창이 뜬다",
      "path": "/production/work-orders",
      "steps": [
        "wait:600",
        "click:신규(F2)",
        "wait:800",
        "js:const i=document.querySelector(\"[role=dialog] table.ec-grid-input input[aria-label='품목']\");i.focus();Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,'QA-PROD');i.dispatchEvent(new Event('input',{bubbles:true}));i.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}));true",
        "wait:400",
        "click:생산공장 선택",
        "pickrow:QA-WH",
        "set:[role=dialog] table.ec-grid-input input[type=number]#0|3",
        "click:저장(F8)",
        "wait:1200",
        "expect:!document.querySelector('[role=dialog][aria-label=\"작업지시서입력\"]')",
        "js:fetch('/api/work-orders',{headers:{Authorization:'Bearer '+localStorage.getItem('erp_token')}}).then((r)=>r.json()).then((d)=>{const w=d.filter((x)=>x.productCode==='QA-PROD').sort((a,b)=>b.id-a.id)[0];sessionStorage.setItem('qaWOW',w?w.orderNo:'');return true})",
        "expect:/WO-[0-9]{8}-[0-9]{4}/.test(sessionStorage.getItem('qaWOW')) && document.body.innerText.includes(sessionStorage.getItem('qaWOW'))",
        "js:[...document.querySelectorAll('tbody tr')].find((tr)=>tr.innerText.includes(sessionStorage.getItem('qaWOW'))).querySelector('td a').click(); true",
        "wait:1000",
        "expect:location.pathname==='/production/work-orders' && !!document.querySelector('[role=dialog][aria-label=\"작업지시서입력(수정)\"]')",
        "apidel:/work-orders|@qaWOW|orderNo",
        "js:sessionStorage.removeItem('qaWOW'); true"
      ]
    },
    {
      "name": "생산입고조회 [생산입고I] — 목록 위에 '생산입고I-BOM기준소모' 창, 생산된공장을 비운 채 [작업지시서] 를 누르면 말풍선 '생산된공장을 입력바랍니다.' 만 뜨고 작업지시서 창은 안 뜬다",
      "path": "/production/receipt-inquiry",
      "steps": [
        "wait:800",
        "expect:![...document.querySelectorAll('thead th')].some((th)=>th.innerText.trim()==='단위') && ![...document.querySelectorAll('.ec-footer button')].some((b)=>b.textContent.trim()==='검색(F8)')",
        "click:생산입고I",
        "wait:800",
        "expect:location.pathname==='/production/receipt-inquiry' && !!document.querySelector('[role=dialog][aria-label=\"생산입고I-BOM기준소모\"]')",
        "js:[...document.querySelectorAll('[role=dialog] .ec-toolbar button')].find((b)=>b.textContent.trim()==='작업지시서').click(); true",
        "wait:400",
        "expect:document.querySelector('[role=dialog]').innerText.includes('생산된공장을 입력바랍니다.') && !document.querySelector('[role=dialog][aria-label=\"작업지시서조회\"]')"
      ]
    },
    {
      "name": "생산입고조회 조건 판 — [생산입고구분] 은 체크(전체 · 생산입고I · II · III), 보내는창고 · 받는창고는 접힌 줄을 펼쳐야 나온다",
      "path": "/production/receipt-inquiry",
      "steps": [
        "wait:600",
        "click:Search(F3)",
        "expect:[...document.querySelectorAll('.ec-cond input[type=checkbox]')].length >= 6 && !/보내는창고/.test(document.querySelector('.ec-cond').innerText)",
        "click:조건 더 보기",
        "expect:/보내는창고/.test(document.querySelector('.ec-cond').innerText)"
      ]
    }
  ],
  "finally": [
    "js:(async()=>{const no=sessionStorage.getItem('qaWOW');if(no){await fetch('/api/work-orders/slips/'+encodeURIComponent(no),{method:'DELETE',headers:{Authorization:'Bearer '+localStorage.getItem('erp_token')}})}return true})()"
  ]
}
