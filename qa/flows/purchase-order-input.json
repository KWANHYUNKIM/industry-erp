  "shots": [
    {
      "name": "발주서입력 — 거래처 없이 품목 한 줄 + 줄 적요 · 머리 적요 → 저장 → API 에 거래처 비고 · 적요 그대로",
      "path": "/sales/purchase-order-input",
      "steps": [
        "wait:1500",
        "js:window.__api = (m, p, b) => fetch('/api' + p, { method: m, headers: {Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'}, body: b ? JSON.stringify(b) : undefined }).then(async (r) => ({ status: r.status, body: await r.json().catch(() => null) })); true",
        "expect:document.querySelectorAll('.ec-form select').length>=2&&document.querySelector('.ec-form').innerText.includes('납기일자')&&document.querySelector('.ec-form').innerText.includes('참조')",
        "expect:[...document.querySelectorAll('thead th')].some((t)=>t.innerText.trim()==='적요')",
        "js:(async()=>{const w=(await window.__api('GET','/warehouses')).body.find((x)=>x.code==='QA-WH');sessionStorage.setItem('poiWh',w.name);return 1})()",
        "pick:품목:QA-PROD",
        "expect:(()=>{const r=document.querySelector('tbody tr');const i=[...r.querySelectorAll('input')];return i[0].value==='QA-PROD'&&i[1].value!=='QA-PROD'&&i[1].value!==''})()",
        "pick:창고:QA-WH",
        "set:input[aria-label=\"줄 적요\"]|QA줄적요",
        "set:input[aria-label=\"참조\"]|QA머리적요",
        "js:(()=>{const q=[...document.querySelector('tbody tr').querySelectorAll('input')].find((i)=>i.className.includes('text-right'));const set=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;q.focus();set.call(q,'3');q.dispatchEvent(new Event('input',{bubbles:true}));q.blur();return true})()",
        "wait:300",
        "click:저장(F8)",
        "wait:2500",
        "js:(async()=>{const o=(await window.__api('GET','/purchase-orders')).body.filter((x)=>x.remark==='QA머리적요');if(o.length!==1)return 'n='+o.length;sessionStorage.setItem('poiId',o[0].id);return 'ok'})()",
        "expect:(async()=>{const o=(await window.__api('GET','/purchase-orders')).body.find((x)=>String(x.id)===sessionStorage.getItem('poiId'));return !!o&&o.partnerId==null&&o.employeeId==null&&o.status==='ORDERED'&&o.lines.length===1&&o.lines[0].remark==='QA줄적요'})()"
      ]
