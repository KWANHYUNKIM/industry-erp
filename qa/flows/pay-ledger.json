        "set:[role=dialog] input[placeholder=\"급여대장명칭\"]|QA관리-화면시험대장",
        "clicklast:저장(F8)",
        "wait:1500",
        "expect:/2091\\/04 -1\\s+급여\\s+1차수\\s+QA관리-화면시험대장/.test(document.querySelector('table').innerText)",
        "click:신규(F2)",
        "wait:500",
        "set:[role=dialog] input[type=month]|2091-04",
        "allowapi:409: /api/pay-ledgers",
        "clicklast:저장(F8)",
        "wait:1000",
        "expect:document.body.innerText.includes('동일기간에 이미 생성된 급여가 있습니다')",
        "clicklast:닫기",
        "js:[...[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-화면시험대장')).querySelectorAll('a')].find(a=>a.textContent==='전체계산').click();true",
        "wait:500",
        "expect:document.body.innerText.includes('전체 계산을 진행하시겠습니까?')&&document.body.innerText.includes('지급총액 0 이하 제외')",
        "clicklast:확인",
