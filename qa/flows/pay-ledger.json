        "expect:/QA관리-화면시험대장[^\\n]*\\n?[\\s\\S]*?[0-9]+\\s+조회/.test(document.querySelector('table').innerText) && /[1-9][0-9,]{5,}/.test([...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-화면시험대장')).innerText)",
        "js:[...[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-화면시험대장')).querySelectorAll('a')].find(a=>a.textContent==='일괄수정').click();true",
        "wait:1500",
        "expect:(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return d.innerText.includes('급여수정 대상자 선택')&&[...d.querySelectorAll('thead th')].map(t=>t.innerText.trim()).filter(Boolean).join(',')==='사원번호,성명,부서명,입사일자,퇴사일자'&&d.querySelectorAll('tbody tr').length>0})()",
        "js:[...document.querySelectorAll('[role=dialog]')].pop().querySelector('tbody input[type=checkbox]').click();true",
        "clicklast:적용",
        "wait:800",
        "expect:(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return d.innerText.includes('급여내역수정')&&d.innerText.includes('2091/04 - 1')&&d.innerText.includes('2091/04/01 ~ 2091/04/30')&&[...d.querySelectorAll('thead th')].map(t=>t.innerText.trim()).includes('공제총액')})()",
        "js:(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();const i=d.querySelector('input[aria-label$=\" 기본급\"]');const tr=i.closest('tr');sessionStorage.setItem('qaBase',i.value.replace(/,/g,''));sessionStorage.setItem('qaGross',tr.children[3].innerText.replace(/,/g,''));sessionStorage.setItem('qaName',i.getAttribute('aria-label').replace(' 기본급',''));return true})()",
        "js:(()=>{const i=[...document.querySelectorAll('[role=dialog]')].pop().querySelector('input[aria-label$=\" 기본급\"]');i.focus();Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,String(Number(sessionStorage.getItem('qaBase'))+100000));i.dispatchEvent(new Event('input',{bubbles:true}));i.blur();return true})()",
        "wait:300",
        "expect:(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();const i=d.querySelector('input[aria-label$=\" 기본급\"]');const tr=i.closest('tr');return Number(tr.children[3].innerText.replace(/,/g,''))===Number(sessionStorage.getItem('qaGross'))+100000&&i.closest('td').className.includes('bg-ec-danger-bg')})()",
        "clicklast:저장(F8)",
        "wait:400",
        "expect:document.body.innerText.includes('금액을 직접 수정할 경우 해당 급여대장에만 적용되며 재계산시 수정내역이 유지되지 않습니다')&&document.body.innerText.includes('사원정보 설정')",
        "clicklast:확인",
        "wait:1500",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};const ps=await (await fetch('/api/payslips?month=2091-04',{headers:h})).json();const p=ps.find(x=>x.employeeName===sessionStorage.getItem('qaName'));sessionStorage.setItem('qaBulk',String(Number(p.baseSalary)===Number(sessionStorage.getItem('qaBase'))+100000&&Number(p.grossPay)===Number(sessionStorage.getItem('qaGross'))+100000));return true})()",
        "expect:sessionStorage.getItem('qaBulk')==='true'",
        "js:[...[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-화면시험대장')).querySelectorAll('a')].find(a=>a.textContent==='개인별계산').click();true",
        "wait:1500",
        "expect:(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return d.innerText.includes('개인별계산')&&[...d.querySelectorAll('thead th')].map(t=>t.innerText.trim()).filter(Boolean).join(',')==='사원번호,성명,부서명,입사일자,퇴사일자'&&d.querySelectorAll('tbody tr').length>0})()",
        "js:window.alert=m=>sessionStorage.setItem('qaAlert',m);true",
        "clicklast:계산처리",
        "expect:(sessionStorage.getItem('qaAlert')||'').includes('선택된 사원이 없습니다')",
        "js:[...document.querySelectorAll('[role=dialog]')].pop().querySelector('tbody input[type=checkbox]').click();true",
        "clicklast:계산처리",
        "wait:500",
        "expect:document.body.innerText.includes('개인별 계산을 진행하겠습니까?')&&document.body.innerText.includes('지급총액 0 이하 제외')",
        "clicklast:확인",
        "wait:2500",
        "wait:2000",
        "expect:location.pathname==='/hr/payroll/ledger' && location.search.includes('2091-04') && document.body.innerText.includes('급여대장')",
        "expect:document.body.innerText.includes('2091/04 급여')&&(()=>{const h=[...document.querySelectorAll('table.ec-report thead th')].map(t=>t.innerText.trim());return h.includes('기본급')&&h.includes('주민세')&&h.includes('지급총액')&&h.includes('실지급액')&&document.querySelectorAll('table.ec-report tbody tr').length>1})()",
        "js:history.back();true",
        "wait:2500",
        "js:[...[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-화면시험대장')).querySelectorAll('a')].filter(a=>a.textContent==='조회').pop().click();true",
        "wait:2500",
        "expect:location.pathname==='/hr/payroll/by-employee' && location.search.includes('ledger=2091-04') && [...document.querySelectorAll('table tbody tr')].some(t=>t.innerText.includes('2091/04'))",
        "js:(async()=>{const t=localStorage.getItem('erp_token');const h={Authorization:'Bearer '+t};const ls=await (await fetch('/api/pay-ledgers',{headers:h})).json();const l=ls.find(x=>x.payMonth==='2091-04');const r=await fetch('/api/pay-ledgers/'+l.id,{method:'DELETE',headers:h});sessionStorage.setItem('qaPl',String(r.ok&&l.headcount>0));return true})()",
        "expect:sessionStorage.getItem('qaPl')==='true'"
      ]
    }
