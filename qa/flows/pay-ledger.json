        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};const ls=await (await fetch('/api/pay-ledgers',{headers:h})).json();const l=ls.find(x=>x.payMonth==='2091-04');const e=Number(sessionStorage.getItem('qaDaEmp'));await fetch('/api/pay-ledgers/'+l.id+'/calculate',{method:'POST',headers:{...h,'Content-Type':'application/json'},body:JSON.stringify({employeeIds:[e]})});const ps=await (await fetch('/api/payslips?month=2091-04',{headers:h})).json();sessionStorage.setItem('qaDa',String(Number(ps.find(p=>p.employeeId===e).baseSalary)===1234000));return true})()",
