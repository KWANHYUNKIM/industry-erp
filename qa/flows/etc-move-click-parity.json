      "path": "/inventory/stocktake-list",
      "steps": [
        "wait:1500",
        "expect:[...document.querySelectorAll('.ec-page-head button')].some((b) => b.textContent.trim() === 'Search(F3)') && !!document.querySelector('.ec-list-body.conds-closed')",
        "expect:[...document.querySelectorAll('.ec-pills .ec-pill')].map((b) => b.textContent.trim()).join('|') === '전체'",
        "expect:(() => { const t = new Date(); const p = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); const v = [...document.querySelectorAll('.ec-cond input[type=date]')].map((i) => i.value); return v[0] === p(new Date(t.getFullYear(), t.getMonth() - 1, 1)) && v[1] === p(new Date(t.getFullYear(), t.getMonth() + 1, 0)) })()"
