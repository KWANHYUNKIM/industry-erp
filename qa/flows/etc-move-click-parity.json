        "expect:[...document.querySelectorAll('table thead th')].map((t) => t.innerText.replace(/[▲▼]/g, '').trim()).slice(1).join('|') === '일자-No.|보내는창고명|받는창고명|품목명[규격명]|수량|인쇄'",
        "expect:![...document.querySelectorAll('button')].some((b) => b.textContent.trim() === '새로고침')",
        "js:document.querySelector('button[aria-label=\"조건 더 보기\"]').click(); true",
        "wait:300",
        "expect:['오더관리번호','최초작성자','최초작성일자','최종작업일자','입력경로','삭제구분'].every((l) => [...document.querySelectorAll('.ec-cond .title')].some((t) => t.innerText.trim() === l))",
        "click:신규(F2)",
        "wait:800",
        "expect:location.pathname === '/inventory/transfer' && /창고이동입력/.test([...document.querySelectorAll('[role=dialog]')].pop().innerText)",
        "expect:['저장(F8)','저장/전표(F7)','다시 작성','닫기'].every((t) => [...[...document.querySelectorAll('[role=dialog]')].pop().querySelectorAll('button')].some((b) => b.textContent.trim() === t))",
        "js:[...[...document.querySelectorAll('[role=dialog]')].pop().querySelectorAll('button')].find((b) => b.textContent.trim() === '전표불러오기').click(); true",
        "wait:500",
        "expect:/메뉴검색/.test([...document.querySelectorAll('[role=dialog]')].pop().innerText)"
      ]
