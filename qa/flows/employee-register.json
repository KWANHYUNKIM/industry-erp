        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};const a=await (await fetch('/api/employees/all',{headers:h})).json();const e=a.find(x=>x.name==='QA관리-화면시험');sessionStorage.setItem('qaBank',String(!!e&&e.bankCode==='088'&&e.bankName==='신한은행'&&e.hireKind==='경력'&&e.duty==='팀장'));return true})()",
