{
  "about": "수령수표조회 [신규(F2)] → 수령수표내역입력 — 수표계좌를 비우고 저장하면 칸만 빨갛게 막고, 수표번호 칸에 들어가면 자동번호(20자리)가 차며, 저장하면 '수표만증가' 줄(회계전표 빈칸)이 생긴다. 감소로 같은 번호를 넣으면 '수표만감소'. 분개 없이 넣은 수표는 수표관리 입금을 막는다. 끝에 두 줄을 선택삭제로 지운다.",
  "shots": [
    {
      "name": "증가 — 수표계좌가 비면 막고, 넣으면 '수표만증가' 줄",
      "path": "/accounting/checks-list",
      "steps": [
        "allowapi:400: /api/checks/",
        "js:window.__set = (label, v) => { const el = document.querySelector(`[aria-label=\"${label}\"]`); el.focus(); const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; set.call(el, v); el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new FocusEvent('focusout', { bubbles: true })); el.blur(); return true }; true",
        "js:window.__api = (m, p, b) => fetch('/api' + p, { method: m, headers: {Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'}, body: b ? JSON.stringify(b) : undefined }).then(async (r) => ({ status: r.status, body: await r.json().catch(() => null) })); true",
        "js:(async()=>{const a=(await window.__api('GET','/bank-cards/accounts')).body.find((x)=>x.active);sessionStorage.setItem('accCode',a.code??a.accountNo);return a.code??a.accountNo})()",
        "click:신규(F2)",
        "wait:800",
        "expect:document.body.innerText.includes('수령수표내역입력')",
        "js:(()=>{const el=document.querySelector('[aria-label=\"1줄 수표번호\"]');el.focus();el.dispatchEvent(new FocusEvent('focusin',{bubbles:true}));return true})()",
        "wait:300",
        "js:(()=>{const v=document.querySelector('[aria-label=\"1줄 수표번호\"]').value;sessionStorage.setItem('dNo',v);return v})()",
        "expect:/^\\d{20}$/.test(sessionStorage.getItem('dNo'))",
        "js:window.__set('1줄 금액','12345')",
        "js:window.__set('1줄 적요','QA회계2 수표만')",
        "click:저장(F8)",
        "wait:500",
        "expect:document.querySelector('[aria-invalid=\"true\"]')!==null",
        "js:window.__set('계좌검색', sessionStorage.getItem('accCode'))",
        "wait:300",
        "click:저장(F8)",
        "wait:2000",
        "expect:(()=>{const tr=[...document.querySelectorAll('tbody tr')].find((t)=>t.innerText.includes(sessionStorage.getItem('dNo')));return !!tr&&tr.cells[3].innerText.trim()==='증가'&&tr.cells[7].innerText.trim()==='수표만증가'&&tr.cells[8].innerText.trim()===''})()",
        "js:(async()=>{const c=(await window.__api('GET','/checks')).body.find((x)=>x.checkNo===sessionStorage.getItem('dNo'));sessionStorage.setItem('dId',c.id);const acc=(await window.__api('GET','/bank-cards/accounts')).body.find((x)=>x.active);const r=await window.__api('POST','/checks/'+c.id+'/deposit',{bankAccountId:acc.id});window.__blocked=r.status===400;return r.status})()",
        "expect:window.__blocked===true"
      ]
    },
    {
      "name": "감소 — 같은 번호를 넣으면 '수표만감소' 줄, 그 뒤 두 줄을 선택삭제",
      "path": "/accounting/checks-list",
      "steps": [
        "js:window.__set = (label, v) => { const el = document.querySelector(`[aria-label=\"${label}\"]`); el.focus(); const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; set.call(el, v); el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new FocusEvent('focusout', { bubbles: true })); el.blur(); return true }; true",
        "click:신규(F2)",
        "wait:800",
        "js:(()=>{const s=document.querySelector('[aria-label=\"전표구분\"]');const set=Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set;set.call(s,'DEC');s.dispatchEvent(new Event('change',{bubbles:true}));return true})()",
        "js:window.__set('1줄 수표번호', sessionStorage.getItem('dNo'))",
        "js:window.__set('1줄 금액','12345')",
        "js:window.__set('계좌검색', sessionStorage.getItem('accCode'))",
        "wait:300",
        "click:저장(F8)",
        "wait:2000",
        "expect:(()=>{const rows=[...document.querySelectorAll('tbody tr')].filter((t)=>t.innerText.includes(sessionStorage.getItem('dNo')));return rows.length===2&&rows[0].cells[3].innerText.trim()==='감소'&&rows[0].cells[7].innerText.trim()==='수표만감소'})()",
        "js:(()=>{[...document.querySelectorAll('tbody tr')].filter((t)=>t.innerText.includes(sessionStorage.getItem('dNo'))).forEach((t)=>t.querySelector('input[type=checkbox]').click());return true})()",
        "click:선택삭제",
        "wait:500",
        "clicklast:확인",
        "wait:2000",
        "expect:!([...document.querySelectorAll('tbody tr')].some((t)=>t.innerText.includes(sessionStorage.getItem('dNo'))))"
      ]
    }
  ]
}
