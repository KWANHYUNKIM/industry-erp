        "set:[role=dialog] input[placeholder=성명]|QA세무-중도퇴직",
        "clicklast:저장(F8)",
        "wait:1000",
        "expect:!document.querySelector('[role=dialog]') && document.querySelector('table').innerText.includes('QA세무-중도퇴직')"
      ]
