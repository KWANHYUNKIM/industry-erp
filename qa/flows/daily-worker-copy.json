{
  "about": "관리 > 일용근로 사원등록(E020105) 수정 창 [복사] · [삭제] — 원본 2026-10-04 실측 버튼 저장(F8) · 복사 · 다시 작성 · 삭제 · 닫기 · H. 복사하면 같은 값으로 새 사원 창(사원번호만 새로) → 저장 → 모바일까지 같다, 그 사원을 열어 [삭제] → 목록에서 빠진다. 시험 사원은 지운다.",
  "shots": [
    {
      "name": "복사 → 저장 → 삭제",
      "path": "/hr/daily-workers",
      "steps": [
        "js:window.confirm=()=>true;true",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const r=await (await fetch('/api/hr/daily-workers',{method:'POST',headers:h,body:JSON.stringify({name:'QA관리-복사원본',hireDate:'2091-01-01',employmentInsurance:true,mobile:'010-7777-8888'})})).json();sessionStorage.setItem('qaDcp',String(r.id));return !!r.id})()",
        "js:location.reload();true",
        "wait:2000",
        "js:window.confirm=()=>true;true",
        "js:(()=>{const tr=[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-복사원본'));tr.querySelector('a').click();return true})()",
        "wait:500",
        "click:복사",
        "wait:800",
        "expect:document.querySelector('[role=dialog] input[placeholder=성명]').value==='QA관리-복사원본'",
        "set:[role=dialog] input[placeholder=성명]|QA관리-복사본",
        "clicklast:저장(F8)",
        "wait:1200",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const ws=await (await fetch('/api/hr/daily-workers',{headers:h})).json();const c=ws.find(x=>x.name==='QA관리-복사본');sessionStorage.setItem('qaDcpCopy',c?String(c.id)+'|'+c.mobile:'none');return true})()",
        "expect:sessionStorage.getItem('qaDcpCopy').endsWith('|010-7777-8888')",
        "js:(()=>{const tr=[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-복사본'));tr.querySelector('a').click();return true})()",
        "wait:500",
        "clicklast:삭제",
        "wait:1200",
        "expect:![...document.querySelectorAll('table tbody tr')].some(t=>t.innerText.includes('QA관리-복사본'))",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const r=await fetch('/api/hr/daily-workers/'+sessionStorage.getItem('qaDcp'),{method:'DELETE',headers:h});sessionStorage.setItem('qaDcpClean',String(r.ok));return true})()",
        "expect:sessionStorage.getItem('qaDcpClean')==='true'"
      ]
    }
  ]
