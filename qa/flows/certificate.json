        "js:document.querySelector('[role=dialog] button[title=\"사원번호 선택\"]').click();true",
        "pickrow:EMP-0001",
        "setnear:용도|QA관리-없음",
        "clicklast:저장(F8)",
        "wait:1200",
        "expect:(()=>{const tr=[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-없음'));return !!tr&&tr.innerText.includes('없음')&&!document.querySelector('[role=dialog]')})()",
        "js:(()=>{const tr=[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-없음'));tr.cells[1].querySelector('a').click();return true})()",
        "wait:500",
        "expect:(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return d.innerText.includes('각종증명서수정')&&d.innerText.includes('재 직 증 명 서')&&[...d.querySelectorAll('button')].some(b=>b.textContent==='삭제')})()",
        "js:document.querySelector('[role=dialog] button[aria-label=\"저장 더보기\"]').click();true",
        "clicklast:저장/전표(F7)",
        "wait:1200",
        "expect:[...document.querySelectorAll('[role=dialog]')].some(d=>d.innerText.includes('각종증명서인쇄')&&d.innerText.includes('QA관리-없음'))",
        "clicklast:닫기",
        "wait:300",
        "js:(()=>{const tr=[...document.querySelectorAll('table tbody tr')].find(t=>t.innerText.includes('QA관리-없음'));tr.cells[1].querySelector('a').click();return true})()",
        "wait:500",
        "clicklast:삭제",
        "wait:1200",
        "expect:!document.querySelector('[role=dialog]')&&![...document.querySelectorAll('table tbody tr')].some(t=>t.innerText.includes('QA관리-없음'))"
      ]
    }
  ]
