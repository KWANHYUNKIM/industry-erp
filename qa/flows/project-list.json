{
  "about": "관리 > 프로젝트등록(E010112) — 원본처럼 [신규(F2)] 창이 다음 프로젝트코드(다섯 자리)를 채워 열리고, 프로젝트명이 비면 막히며, 저장하면 안내 없이 목록에 Yes 로 붙는다. 사용중단하면 목록에서 빠지고 [사용중단포함]에 보인다. 만든 프로젝트는 지운다.",
  "shots": [
    {
      "name": "프로젝트 등록 → 사용중단 → 뒷정리",
      "path": "/inventory/projects",
      "steps": [
        "js:(async()=>{const t=localStorage.getItem('erp_token');const h={Authorization:'Bearer '+t,'Content-Type':'application/json'};await fetch('/api/project-groups',{method:'POST',headers:h,body:JSON.stringify({code:'QAPG1',name:'QA프로젝트그룹'})});return true})()",
        "js:location.reload()",
        "wait:1500",
        "click:신규(F2)",
        "wait:600",
        "expect:/^[0-9]{5}$/.test(document.querySelector('[role=dialog] input.ec-input').value)",
        "js:(async()=>{const t=localStorage.getItem('erp_token');const ps=await (await fetch('/api/projects',{headers:{Authorization:'Bearer '+t}})).json();const n=ps.map(x=>x.code).filter(c=>/^\\d{5}$/.test(c)).map(Number);sessionStorage.setItem('qaNext',String((n.length?Math.max(...n):0)+1).padStart(5,'0'))})()",
        "wait:800",
        "expect:document.querySelector('[role=dialog] input.ec-input').value===sessionStorage.getItem('qaNext')",
        "expect:[...document.querySelectorAll('[role=dialog] .ec-tab')].map(x=>x.textContent).join()==='기본,프로젝트정보,부가정보'",
        "clicklast:저장(F8)",
        "expect:document.querySelector('[role=dialog] input[placeholder=\"프로젝트명\"]')?.getAttribute('aria-invalid') === 'true'",
        "set:[role=dialog] input[placeholder=\"프로젝트명\"]|QA관리-화면시험프로젝트",
        "expect:[...document.querySelectorAll('[role=dialog] .ec-form li')].filter(l=>!l.classList.contains('hidden')).map(l=>l.querySelector('.title').textContent).join()==='프로젝트코드,프로젝트명,프로젝트그룹1,프로젝트그룹2,적요'",
        "pick:프로젝트그룹1:QAPG1",
        "expect:/QAPG1|QA프로젝트그룹/.test([...document.querySelectorAll('[role=dialog] input')].map(x=>x.value).join('|'))",
        "set:[role=dialog] input[name=extraText1]|QA문자",
        "set:[role=dialog] input[name=extraNum2]|123.5",
        "set:[role=dialog] input[name=extraDate3]|2026-10-28",
        "clicklast:저장(F8)",
        "wait:2500",
        "expect:!document.querySelector('[role=dialog]') && /QA관리-화면시험프로젝트\\s+Yes/.test(document.querySelector('table').innerText)",
        "js:(async()=>{const t=localStorage.getItem('erp_token');const h={Authorization:'Bearer '+t,'Content-Type':'application/json'};const ps=await (await fetch('/api/projects',{headers:h})).json();const p=ps.find(x=>x.name==='QA관리-화면시험프로젝트');sessionStorage.setItem('qaExtra',String(p.group1==='QAPG1'&&p.extraText1==='QA문자'&&Number(p.extraNum2)===123.5&&p.extraDate3==='2026-10-28'));return true})()",
        "expect:sessionStorage.getItem('qaExtra')==='true'",
        "js:[...document.querySelectorAll('table a')].find(a=>a.textContent==='QA관리-화면시험프로젝트').click()",
        "wait:600",
        "js:[...document.querySelectorAll('[role=dialog] .ec-tab')].find(x=>x.textContent==='부가정보').click()",
        "expect:document.querySelector('[role=dialog] input[name=extraText1]').value==='QA문자' && Number(document.querySelector('[role=dialog] input[name=extraNum2]').value)===123.5 && document.querySelector('[role=dialog] input[name=extraDate3]').value==='2026-10-28'",
        "click:닫기",
        "js:(async()=>{const t=localStorage.getItem('erp_token');const h={Authorization:'Bearer '+t,'Content-Type':'application/json'};const ps=await (await fetch('/api/projects',{headers:h})).json();const p=ps.find(x=>x.name==='QA관리-화면시험프로젝트');const off=await (await fetch('/api/projects/'+p.id,{method:'PATCH',headers:h,body:JSON.stringify({active:false})})).json();const del=await fetch('/api/projects/'+p.id,{method:'DELETE',headers:h});const gs=await (await fetch('/api/project-groups',{headers:h})).json();const g=gs.find(x=>x.code==='QAPG1');if(g)await fetch('/api/project-groups/'+g.id,{method:'DELETE',headers:h});sessionStorage.setItem('qaPrj',String(off.active===false&&del.ok));return true})()",
        "expect:sessionStorage.getItem('qaPrj')==='true'"
      ]
    }
  ]
}