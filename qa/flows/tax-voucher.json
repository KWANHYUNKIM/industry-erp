        "pickrow:BOTH-001",
        "setnear:비고|QA세무 흐름",
        "js:(() => { const d = [...document.querySelectorAll('[role=dialog]')].pop(); const el = [...d.querySelectorAll('input')].find((i) => i.classList.contains('text-right')); el.focus(); Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(el, '100000'); el.dispatchEvent(new Event('input', { bubbles: true })); return true })()",
        "wait:300",
        "expect:[...[...document.querySelectorAll('[role=dialog]')].pop().querySelectorAll('input.text-right')].map((i) => i.value.replace(/,/g, '')).join('|') === '100000|10000'",
        "clicklast:저장(F8)",
        "wait:1000",
        "expect:[...document.querySelectorAll('tbody tr')].some((t) => /매출\\s+BOTH-001\\s+\\S+\\s+QA세무 흐름\\s+100,000\\s+10,000\\s+110,000/.test(t.innerText))"
      ]
    },
