{
  "about": "자가사용입력(E040503) · 자가사용조회의 자가사용수정 창 — 2026-10-12 원본 실측. 창고 없이 저장하면 막히고, 두 줄 전표(API)는 조회에 '품목 외 1건' · 수량 합 한 줄로 뜬다. [일자-No.] 를 누르면 수정 창(일자 잠김)이 뜨고 [삭제]로 지우면 두 품목 재고가 되돌아온다.",
  "shots": [
    {
      "name": "자가사용입력 — 격자 [품목코드 · 품목명 · 규격 · 수량 · 사용유형], 창고 없이 저장하면 '창고를 입력하세요.'",
      "path": "/inventory/self-use-input",
      "steps": [
        "wait:800",
        "expect:[...document.querySelectorAll('table thead th')].map((t)=>t.innerText.trim()).join('|')==='|품목코드|품목명|규격|수량|사용유형'",
        "click:저장(F8)",
        "wait:400",
        "expect:document.body.innerText.includes('창고를 입력하세요.')"
      ]
    },
    {
      "name": "자가사용조회 — 두 줄 전표가 '외 1건' · 수량 5 로 뜨고, 수정 창에서 삭제하면 재고가 되돌아온다",
      "path": "/inventory/self-use",
      "steps": [
        "js:window.__api = (m, p, b) => fetch('/api' + p, { method: m, headers: {Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'}, body: b ? JSON.stringify(b) : undefined }).then(async (r) => ({ status: r.status, body: await r.json().catch(() => null) })); true",
        "js:(async()=>{const st=(await window.__api('GET','/stock')).body;const a=st.find((s)=>Number(s.quantity)>=10);const b=st.find((s)=>s.warehouseId===a.warehouseId&&s.itemId!==a.itemId&&Number(s.quantity)>=10);sessionStorage.setItem('su',JSON.stringify({wh:a.warehouseId,a:a.itemId,b:b.itemId,qa:Number(a.quantity),qb:Number(b.quantity)}));const r=await window.__api('POST','/stock-adjustments/slips',{type:'SELF_USE',warehouseId:a.warehouseId,lines:[{itemId:a.itemId,quantity:2,kind:'QA재고1'},{itemId:b.itemId,quantity:3}]});sessionStorage.setItem('suNo',r.body&&r.body.adjustNo);return r.status})()",
        "wait:600",
        "js:[...document.querySelectorAll('button')].find((b) => b.innerText.trim() === 'Search(F3)').click(); true",
        "wait:400",
        "click:검색(F8)",
        "wait:1500",
        "expect:(()=>{const no=sessionStorage.getItem('suNo');const dn=no.slice(3,7)+'/'+no.slice(7,9)+'/'+no.slice(9,11)+' -'+Number(no.split('-').pop());const tr=[...document.querySelectorAll('tbody tr')].find((t)=>t.cells[1]&&t.cells[1].innerText.trim()===dn);return !!tr&&/외 1건$/.test(tr.cells[4].innerText.trim())&&tr.cells[5].innerText.trim()==='5'})()",
        "js:(()=>{const no=sessionStorage.getItem('suNo');const dn=no.slice(3,7)+'/'+no.slice(7,9)+'/'+no.slice(9,11)+' -'+Number(no.split('-').pop());[...document.querySelectorAll('tbody tr a')].find((a)=>a.innerText.trim()===dn).click();return true})()",
        "wait:1200",
        "expect:(()=>{const d=document.querySelector('[role=dialog]');return !!d&&d.innerText.includes('자가사용수정')&&d.querySelector('input[type=date]').disabled&&d.querySelectorAll('tbody tr').length>=3})()",
        "js:window.confirm=()=>true; [...document.querySelectorAll('[role=dialog] button')].find((b)=>b.innerText.trim()==='삭제').click(); true",
        "wait:1500",
        "expect:!document.querySelector('[role=dialog]')",
        "js:(async()=>{const s=JSON.parse(sessionStorage.getItem('su'));const st=(await window.__api('GET','/stock')).body;const q=(i)=>Number(st.find((x)=>x.itemId===i&&x.warehouseId===s.wh).quantity);window.__ok=q(s.a)===s.qa&&q(s.b)===s.qb;return window.__ok})()",
        "wait:500",
        "expect:window.__ok===true"
      ]
    }
  ]
}
