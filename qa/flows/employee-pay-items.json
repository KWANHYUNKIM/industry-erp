{
  "about": "관리 > 사원등록 [급여지급사항](E090101) — 원본 2026-10-12 실측(2019-002 변종호): > 고정수당(기본급 · 출산보육수당 · 부양가족수당 · 식대 · 차량유지비, 끝 줄 합계) · > 일급수당(연차수당) · > 시급수당(야근수당 · 주말근무수당) · > 월정공제(연말정산 · 사우회비). 출산보육수당 10,000 을 넣고 저장 → 급여계산/대장 개인별계산 → 그 사원 지급총액 4,759,000 → 4,769,000, 지우고 다시 계산하면 되돌아감. 우리도 칸에 넣은 금액이 합계에 바로 붙고, 저장하면 다시 열어도 남고, 급여명세를 셈하면 그 항목 줄이 그 금액이 된다. 시험 사원 · 명세는 지운다.",
  "shots": [
    {
      "name": "급여지급사항 — 식대 입력 → 합계 → 저장 → 다시 열기 → 급여명세 셈 → 정리",
      "path": "/hr/employees",
      "steps": [
        "wait:1500",
        "js:window.confirm=()=>true;true",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const r=await (await fetch('/api/employees',{method:'POST',headers:h,body:JSON.stringify({name:'QA관리-급여지급',hireDate:'2091-01-01',baseSalary:2000000,payType:'FIXED'})})).json();sessionStorage.setItem('qaPiEmp',String(r.id));return !!r.id})()",
        "js:location.reload();true",
        "wait:2500",
        "js:(async()=>{for(let i=0;i<20&&!document.querySelector('[role=dialog]');i++){const a=[...document.querySelectorAll('table tbody a')].find(a=>a.textContent.trim()==='QA관리-급여지급');if(a)a.click();await new Promise(z=>setTimeout(z,500))}return true})()",
        "wait:1000",
        "js:[...document.querySelectorAll('[role=dialog] button, [role=dialog] a, [role=dialog] li')].find(b=>b.textContent.trim()==='급여지급사항').click();true",
        "wait:800",
        "expect:(()=>{const t=[...document.querySelectorAll('[role=dialog]')].pop().innerText;return ['> 고정수당','> 일급수당','> 시급수당','> 월정공제','수당항목명','공제항목명'].every(s=>t.includes(s))&&!!document.querySelector('input[aria-label=\"식대 금액\"]')})()",
        "js:(()=>{const i=document.querySelector('input[aria-label=\"식대 금액\"]');i.focus();Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,'123000');i.dispatchEvent(new Event('input',{bubbles:true}));i.blur();return true})()",
        "expect:[...document.querySelectorAll('[role=dialog]')].pop().innerText.includes('2,123,000')",
        "clicklast:저장(F8)",
        "wait:1500",
        "expect:!document.querySelector('[role=dialog]')",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};const e=sessionStorage.getItem('qaPiEmp');const r=await (await fetch('/api/pay-settings/employees/'+e+'/items',{headers:h})).json();sessionStorage.setItem('qaPiSaved',String(r.length===1&&r[0].payItemName==='식대'&&Number(r[0].amount)===123000));return true})()",
        "expect:sessionStorage.getItem('qaPiSaved')==='true'",
        "js:(async()=>{for(let i=0;i<20&&!document.querySelector('[role=dialog]');i++){const a=[...document.querySelectorAll('table tbody a')].find(a=>a.textContent.trim()==='QA관리-급여지급');if(a)a.click();await new Promise(z=>setTimeout(z,500))}return true})()",
        "wait:1000",
        "js:[...document.querySelectorAll('[role=dialog] button, [role=dialog] a, [role=dialog] li')].find(b=>b.textContent.trim()==='급여지급사항').click();true",
        "wait:800",
        "expect:document.querySelector('input[aria-label=\"식대 금액\"]').value==='123,000'",
        "clicklast:닫기",
        "wait:500",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token'),'Content-Type':'application/json'};const e=Number(sessionStorage.getItem('qaPiEmp'));const p=await (await fetch('/api/payslips',{method:'POST',headers:h,body:JSON.stringify({employeeId:e,payMonth:'2091-07'})})).json();const meal=(p.lines||[]).filter(l=>l.name==='식대');sessionStorage.setItem('qaPiCalc',String(meal.length===1&&Number(meal[0].amount)===123000));if(p.id)await fetch('/api/payslips/'+p.id,{method:'DELETE',headers:h});return true})()",
        "expect:sessionStorage.getItem('qaPiCalc')==='true'",
        "js:(async()=>{const h={Authorization:'Bearer '+localStorage.getItem('erp_token')};await fetch('/api/employees/'+sessionStorage.getItem('qaPiEmp'),{method:'DELETE',headers:h});return true})()"
      ]
    }
  ]
