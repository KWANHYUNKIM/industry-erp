        "expect:!![...document.querySelectorAll('tbody tr')].find((t)=>t.cells[1]&&t.cells[1].innerText.trim()===sessionStorage.getItem('txNo'))&&![...document.querySelectorAll('.ec-footer button')].some((x)=>['확인','확인취소'].includes(x.textContent.trim()))"
