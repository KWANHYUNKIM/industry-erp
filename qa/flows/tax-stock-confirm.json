        "wait:300",
        "expect:!![...document.querySelectorAll('tbody tr')].find((t)=>t.cells[1]&&t.cells[1].innerText.trim()===sessionStorage.getItem('txNo'))",
        "js:[...document.querySelectorAll('.ec-pill')].find((b)=>b.textContent.trim()==='전체').click(); true",
